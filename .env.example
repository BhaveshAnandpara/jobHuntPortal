# Configuration placeholder — copy to .env and fill in per
# about_project.md's technology table. No component reads this file yet.

# PostgreSQL (infrastructure/database) — docs/architecture/database-ownership.md
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/career_platform

# Kafka (infrastructure/kafka) — docs/architecture/kafka-topics.md
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# LLM Provider Layer (infrastructure/llm). LLM_PROVIDER selects which
# `LLMProvider` LLMClient builds when none is injected — "groq" (primary,
# default when unset — groq_provider.py), "gemini" (alternative cloud
# provider — gemini_provider.py), or "ollama" (local-first alternative per
# about_project.md — ollama_provider.py). Only the selected provider's
# variables are read.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# People-search provider (infrastructure/external/people_search.py), used by
# Contact Discovery Service. PEOPLE_SEARCH_PROVIDER selects the
# implementation. Unset/anything else falls back to the zero-credential
# StaticPeopleSearchProvider([]) (no real contacts found).
#
#   "google-cse" -> PublicWebSearchProvider (Google Programmable Search
#     Engine's Custom Search JSON API). Needs PEOPLE_SEARCH_API_KEY and
#     PEOPLE_SEARCH_ENGINE_ID (a configured Programmable Search Engine id) —
#     https://programmablesearchengine.google.com/. NOTE: closed to new
#     customers as of 2025 and being retired entirely on 2027-01-01
#     (https://developers.google.com/custom-search/v1/overview) — only
#     usable if the underlying Google Cloud project already had access
#     before the cutoff; otherwise every call fails with 403.
#   "serpapi" -> SerpApiProvider (https://serpapi.com/). Needs only
#     PEOPLE_SEARCH_API_KEY. Genuinely recurring free tier as of this
#     writing (250 searches/month, 50/hour cap).
#   "serper" -> SerperProvider (https://serper.dev/). Needs only
#     PEOPLE_SEARCH_API_KEY. Larger one-time free allowance (2,500 queries,
#     no card required) rather than a recurring monthly quota; cheapest
#     paid rate of the three if usage grows past that.
#
# All three support site:-restricted queries (default: site:linkedin.com/in)
# — PEOPLE_SEARCH_ENGINE_ID is only used by "google-cse".
PEOPLE_SEARCH_PROVIDER=
PEOPLE_SEARCH_API_KEY=
PEOPLE_SEARCH_ENGINE_ID=

# API app (api/main.py)
API_HOST=0.0.0.0
API_PORT=8000

# Authentication (infrastructure/auth) — JWT signing. JWT_SECRET_KEY is a
# real secret with no safe default; generate one per deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# CHANGE THIS before using anywhere but a throwaway local dev database.
JWT_SECRET_KEY=change-this-to-a-real-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=10080
